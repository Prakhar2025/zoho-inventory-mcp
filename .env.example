# Zoho Inventory connector configuration.
# Copy this file to .env and fill in your own values. Never commit .env.

# From the Zoho API Console (https://api-console.zoho.in), after creating a Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Long lived refresh token obtained once via scripts/get_refresh_token.py
ZOHO_REFRESH_TOKEN=

# Organization id of your Zoho Inventory org (shown in the Zoho org settings or via the orgs API)
ZOHO_ORG_ID=

# Data center: in (India, default), us, eu
ZOHO_DC=in

# Optional: minimum seconds between API calls (free plan is rate limited; default 0.5)
# CALL_SPACING_SECONDS=0.5

# Optional: Bedrock model id for the demo agent (agent/demo.py)
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.jsonl
